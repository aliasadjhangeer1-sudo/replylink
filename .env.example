# ── ReplyLink .env.example — copy to .env.local. NEVER commit real secrets. ──
# See README.md § Setup for where each value comes from.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ReplyLink
NODE_ENV=development

# ── Supabase (Phase 1 — REQUIRED) ──
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi... # anon / publishable key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi... # server-only, NEVER NEXT_PUBLIC_*
SUPABASE_PROJECT_ID=your-project-ref

# ── Meta / Facebook App (Phase 2 — create now, use in Phase 2) ──
# developers.facebook.com → My Apps → Create App (Business type)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=replylink_verify_choose_a_random_string # must match webhook config in Meta dashboard
META_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback
# AES-256 token encryption — generate: openssl rand -hex 32 (64 hex chars)
TOKEN_ENCRYPTION_KEY=

# ── Queue (Phase 2) — pick ONE ──
# Option A: Supabase Edge Functions + pg_cron (no extra key needed)
# Option B: Upstash QStash / Redis
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Stripe — international USD (Phase 4) ──
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from Stripe Dashboard → Products (create after plans seed):
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_AGENCY_MONTHLY=price_...
STRIPE_PRICE_AGENCY_YEARLY=price_...

# ── Pakistan payments — Safepay OR PayFast (Phase 4, PKR) ──
PAYMENT_PROVIDER_PK=safepay # safepay | payfast | manual
SAFEPAY_API_KEY=
SAFEPAY_API_SECRET=
SAFEPAY_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Manual fallback (JazzCash / Easypaisa / bank) — shown on Billing page, approved in /admin
MANUAL_PAYMENT_JAZZCASH_NUMBER=0335-2607276
MANUAL_PAYMENT_EASYPAISA_NUMBER=0335-2607276
MANUAL_PAYMENT_BANK_ACCOUNT= # IBAN + bank name, shown only to logged-in users

# ── Email (Supabase Auth uses its own SMTP by default; Resend optional) ──
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@replylink.pk

# ── Admin ──
ADMIN_EMAILS=asad@example.com # comma-separated; first admin promoted via SQL in README
